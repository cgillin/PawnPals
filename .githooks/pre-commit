#!/usr/bin/env bash
# Pre-commit: check formatting of staged Swift files before they're committed,
# so lint problems are caught here instead of in CI.
#
# Turn it on once per clone:   git config core.hooksPath .githooks
# Fix problems automatically:  git ls-files '*.swift' | xargs swift format --in-place --configuration .swift-format
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.swift')
[ -z "$staged" ] && exit 0

if ! printf '%s\n' "$staged" | xargs swift format lint --strict --configuration .swift-format; then
  echo
  echo "swift-format found problems in the files above."
  echo "Fix them with:  git ls-files '*.swift' | xargs swift format --in-place --configuration .swift-format"
  echo "then 'git add' the files and commit again."
  exit 1
fi
